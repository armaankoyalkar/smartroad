# SmartRoad ML service (FastAPI). Copy to ml/.env; ml/.env is git-ignored.
ML_HOST=127.0.0.1
ML_PORT=8000
# Leave empty locally (the service logs a warning and skips the X-API-Key check).
# In deployment set the same value as backend ML_SERVICE_API_KEY.
ML_API_KEY=
# Directory holding model.joblib, metrics.json and baseline.json (relative to ml/ or absolute).
ML_ARTIFACTS_DIR=artifacts
# debug | info | warning | error
ML_LOG_LEVEL=info
