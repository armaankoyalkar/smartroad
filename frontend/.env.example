# SmartRoad frontend (Vite). Only variables prefixed with VITE_ reach the browser.
# Copy this file to .env and adjust for your machine. Never commit .env.

# Origin of the Express API (no trailing slash). Image URLs from the API are relative to it.
VITE_API_URL=http://localhost:5000

# Base map tiles and the attribution shown on every map (OpenStreetMap usage policy).
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Reverse geocoding endpoint used by the location picker (at most one request per second).
VITE_GEOCODE_URL=https://nominatim.openstreetmap.org/reverse
