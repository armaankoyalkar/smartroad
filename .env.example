# SmartRoad environment variables (reference copy).
#
# Each service reads its own file. Copy the matching section:
#   backend/.env.example  -> backend/.env
#   frontend/.env.example -> frontend/.env
#   ml/.env.example       -> ml/.env
# Never commit a real .env file. The values below are placeholders.

# ============================================================
# backend/.env  (Express API)
# ============================================================
NODE_ENV=development
PORT=5000
# Local MongoDB or an Atlas connection string (mongodb+srv://...)
MONGODB_URI=mongodb://127.0.0.1:27017/smartroad
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=10
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Image uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
# Python ML service. ML_SERVICE_API_KEY must equal ML_API_KEY on the ML service (both may be empty locally).
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_API_KEY=
ML_TIMEOUT_MS=8000
# Timezone used for hour/day features and timeline buckets
ANALYTICS_TIMEZONE=Asia/Kolkata
# Demo accounts created by `npm run seed` (development only; change the passwords)
SEED_ADMIN_NAME=SmartRoad Admin
SEED_ADMIN_EMAIL=admin@smartroad.demo
SEED_ADMIN_PASSWORD=Admin@Demo2026
SEED_DEMO_PASSWORD=Citizen@Demo2026
# Default map view served by GET /api/meta/enums (Hyderabad)
MAP_CENTER_LAT=17.3850
MAP_CENTER_LNG=78.4867
MAP_ZOOM=12
# Set to 1 behind a reverse proxy so rate limits see the client IP
TRUST_PROXY=0
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MIN=15
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MIN=15
RATE_LIMIT_REPORTS_PER_HOUR=20
# Request logging: dev | combined | none
LOG_FORMAT=dev
# Integration tests: point at a local MongoDB to avoid downloading mongodb-memory-server binaries
MONGODB_TEST_URI=mongodb://127.0.0.1:27017

# ============================================================
# frontend/.env  (Vite; only VITE_* variables reach the browser)
# ============================================================
VITE_API_URL=http://localhost:5000
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
VITE_GEOCODE_URL=https://nominatim.openstreetmap.org/reverse

# ============================================================
# ml/.env  (FastAPI ML service)
# ============================================================
ML_HOST=127.0.0.1
ML_PORT=8000
# Leave empty locally; set the same value as backend ML_SERVICE_API_KEY in deployment
ML_API_KEY=
ML_ARTIFACTS_DIR=artifacts
ML_LOG_LEVEL=info
