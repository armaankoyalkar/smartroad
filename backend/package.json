{
  "name": "smartroad-backend",
  "version": "0.2.0",
  "private": true,
  "description": "SmartRoad REST API (Express 5 + MongoDB)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\"",
    "seed": "node --env-file=.env src/scripts/seed.js",
    "seed:load": "node --env-file=.env src/scripts/seed.js --load 1000",
    "seed:clear": "node --env-file=.env src/scripts/seed.js --clear",
    "create-admin": "node --env-file=.env src/scripts/createAdmin.js",
    "deactivate-user": "node --env-file=.env src/scripts/deactivateUser.js"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.4",
    "morgan": "^1.12.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  }
}
