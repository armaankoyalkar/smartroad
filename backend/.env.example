# SmartRoad backend environment. Copy to .env and fill in the values.
# Never commit .env. Every variable is validated at start-up (src/config/env.js).

# development | test | production
NODE_ENV=development
PORT=5000

# Local MongoDB or an Atlas connection string (mongodb+srv://...)
MONGODB_URI=mongodb://127.0.0.1:27017/smartroad

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=10

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173

# Image uploads (Phase 4)
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Python ML service (Phase 8). The API key must match ML_API_KEY on the ML service.
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_API_KEY=
ML_TIMEOUT_MS=5000

# First administrator, created by `npm run seed`
SEED_ADMIN_NAME=SmartRoad Admin
SEED_ADMIN_EMAIL=admin@smartroad.local
SEED_ADMIN_PASSWORD=change-this-admin-password
# Password shared by the demo citizen accounts created by the seed script
SEED_DEMO_PASSWORD=demo-citizen-password

# Default map view served by GET /api/meta/enums (Hyderabad)
MAP_CENTER_LAT=17.3850
MAP_CENTER_LNG=78.4867
MAP_ZOOM=12

# Set to 1 behind a reverse proxy (Render, Railway) so rate limits see the client IP
TRUST_PROXY=0

# Rate limits
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MIN=15
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_MIN=15
RATE_LIMIT_REPORTS_PER_HOUR=20

# Request logging: dev | combined | none
LOG_FORMAT=dev
